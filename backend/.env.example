# Copy this file to `.env` and fill in real values for local development.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
PROJECT_NAME="AI-Powered Sales Forecasting Platform Using Predictive Analytics"
ENVIRONMENT=development        # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salesgenie
# Optional: set this directly to override the assembled DSN above.
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:postgres@localhost:5432/salesgenie

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------------------------------------------------------------------------
# CORS (comma-separated list of allowed origins)
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# AI integration (Lead Intelligence, Scoring, Outreach, Conversation
# Summarization). "mock" needs no credentials and is the default so the
# app is fully runnable/demoable out of the box; set AI_PROVIDER=gemini
# and provide GEMINI_API_KEY for live AI features.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock                # mock | gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ---------------------------------------------------------------------------
# Email integration (Outreach sending). "console" logs the email instead
# of sending it — no SMTP credentials needed for local dev.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console           # console | smtp
EMAIL_FROM_ADDRESS=noreply@salesgenie.ai
EMAIL_FROM_NAME="AI-Powered Sales Forecasting Platform Using Predictive Analytics"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Calendar integration (follow-up meeting scheduling). "mock" logs the
# event instead of creating a real calendar entry.
# ---------------------------------------------------------------------------
CALENDAR_PROVIDER=mock            # mock | google
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3
CALENDAR_REQUEST_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# CRM integration (sync leads to an external CRM). "mock" always succeeds
# and needs no credentials.
# ---------------------------------------------------------------------------
CRM_DEFAULT_PLATFORM=mock          # mock | salesforce | hubspot
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
CRM_REQUEST_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
