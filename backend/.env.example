# Copy this file to `.env` and fill in real values for local development.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
PROJECT_NAME="SalesGenie AI"
ENVIRONMENT=development        # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salesgenie
# Optional: set this directly to override the assembled DSN above.
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:postgres@localhost:5432/salesgenie

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------------------------------------------------------------------------
# CORS (comma-separated list of allowed origins)
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
